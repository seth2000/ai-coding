# Store text with LF in the repository; Git converts on checkout per platform.
* text=auto eol=lf

# Windows-only scripts keep CRLF so they still run in cmd and PowerShell.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
